{
  "name": "reading-workbench",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @read/desktop dev",
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "storybook": "pnpm --filter @read/ui storybook",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/out packages/*/dist"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
