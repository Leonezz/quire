{
  "name": "@read/normalize",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "capture \u2192 materialization \u2192 representations (reader.document v1/v2, agent GFM, selection text). Node only; the contract subpath is browser-safe.",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts",
    "./contract/v1": "./src/reader-document-contract.ts",
    "./contract/v2": "./src/reader-document-v2-contract.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "echo 'normalize: consumed from source; the desktop app bundles it'",
    "test": "vitest run"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "defuddle": "0.19.3",
    "linkedom": "0.18.13",
    "fast-xml-parser": "5.11.0",
    "unified": "11.0.5",
    "remark-parse": "11.0.0",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "mdast-util-to-string": "4.0.0",
    "micromark-util-normalize-identifier": "2.0.1",
    "micromark-util-decode-string": "2.0.1",
    "decode-named-character-reference": "1.3.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "rehype-parse": "9.0.1",
    "rehype-sanitize": "6.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "@types/node": "^22",
    "@types/hast": "^3",
    "@types/mdast": "^4",
    "@types/turndown": "^5"
  }
}
