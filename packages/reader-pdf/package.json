{
  "name": "@read/reader-pdf",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "PDF reading surface on pdf.js: continuous pages, zoom, rotation, thumbnails, outline, search, page-position memory. Browser only.",
  "exports": {
    ".": "./src/index.ts",
    "./reader-pdf.css": "./src/pdf-canvas-viewer.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "echo 'reader-pdf: consumed from source'",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "react-pdf": "11.0.0",
    "pdfjs-dist": "6.3.289",
    "lucide-react": "1.46.0"
  },
  "devDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "jsdom": "^26.1.0"
  }
}
