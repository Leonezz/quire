{
  "name": "@read/desktop",
  "version": "0.2.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Quire — a reading workbench for blogs, papers and the web (Tauri 2)",
  "author": "Leonezz",
  "homepage": "https://github.com/Leonezz/quire",
  "scripts": {
    "dev:web": "node scripts/build-artifact-runtime.mjs && vite",
    "build:web": "node scripts/build-artifact-runtime.mjs && vite build",
    "dev": "tauri dev",
    "build": "pnpm build:web",
    "tauri": "tauri",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "package": "tauri build --bundles app,dmg",
    "package:dir": "tauri build --bundles app"
  },
  "dependencies": {
    "@read/core": "workspace:*",
    "@read/normalize": "workspace:*",
    "@read/reader": "workspace:*",
    "@read/reader-pdf": "workspace:*",
    "@read/ui": "workspace:*",
    "@tauri-apps/api": "^2.9.0",
    "fflate": "0.8.3",
    "linkedom": "0.18.13",
    "lucide-react": "1.46.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "react-resizable-panels": "4.12.4",
    "sucrase": "3.35.1"
  },
  "devDependencies": {
    "@tailwindcss/browser": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2.9.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "d3": "7.9.0",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "lodash": "4.17.21",
    "mermaid": "12.2.0",
    "recharts": "3.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "^7.3.8",
    "vitest": "4.1.11"
  }
}
