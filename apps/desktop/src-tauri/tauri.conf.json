{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quire",
  "version": "0.2.0-alpha.1",
  "identifier": "app.quire.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../out/renderer"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Quire",
        "width": 1360,
        "height": 880,
        "minWidth": 980,
        "minHeight": 600,
        "decorations": true,
        "hiddenTitle": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 18,
          "y": 20
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "../out/artifact-runtime/*": "artifact-runtime/"
    },
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
